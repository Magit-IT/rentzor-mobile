{
  "expo": {
    "name": "Rentzor",
    "slug": "rentzor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.rentzor.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:rentzor.uz",
        "applinks:www.rentzor.uz"
      ]
    },
    "android": {
      "package": "uz.rentzor.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "rentzor.uz",
              "pathPrefix": "/item"
            },
            {
              "scheme": "https",
              "host": "www.rentzor.uz",
              "pathPrefix": "/item"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rentzor uses your location to show items and addresses near you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class uz.myid.** { *; }\n-keep class com.yandex.** { *; }\n-keep class ru.yandex.** { *; }\n-dontwarn uz.myid.**\n-dontwarn com.yandex.**"
          }
        }
      ],
      [
        "react-native-yamap-plus",
        {
          "android_useYandexMapKitLite": true,
          "ios_useYandexMapKitLite": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rentzor needs access to your photos so you can upload pictures for your profile, item listings, and booking handover photos.",
          "cameraPermission": "Rentzor needs access to your camera to take photos for your profile, item listings and booking handovers, and to verify your identity with MyID.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withMyId"
    ],
    "scheme": "rentzor",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cbb73cd-7473-4187-b7b9-93d4c0ab8f0e"
      }
    },
    "owner": "yusufcocos-team"
  }
}

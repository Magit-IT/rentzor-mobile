{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [],
    "noUnusedLocals": true
  },
  "include": [
    "src",
    "remotion.config.ts",
    "../src/theme.ts",
    "../src/assets/logoPaths.ts"
  ]
}
